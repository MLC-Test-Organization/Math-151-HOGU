<diagram xmlns="https://prefigure.org" dimensions="(300,300)" margins="5">
<definition>base(t) = (9*cos(t), -9 + 2*sin(t))</definition>
  <coordinates bbox="(-12,-12,12,12)">
      <parametric-curve function="base" domain="(0, pi)" stroke="black" thickness="1" dash="9 9"/>
      <parametric-curve function="base" domain="(pi, 2*pi)" stroke="black" thickness="2"/>
      <ellipse center="(0,9)" axes="(9,2)" stroke="black" degrees="no"/>
      <line endpoints="((0,9),(9,9))" stroke="black" thickness="1" dash="9 9"/>
      <line endpoints="((-9,9),(-9,-9))" stroke="black" thickness="2"/>
      <line endpoints="((9,9),(9,-9))" stroke="black" thickness="2"/>
      <label anchor="(-9,0)" alignment="w"><m>\large h</m></label>
      <label anchor="(9,0)" alignment="east"><m>\large h</m></label>
      <label anchor="(4.5,9)" alignment="north"><m>\large r</m></label>
  </coordinates>
</diagram>