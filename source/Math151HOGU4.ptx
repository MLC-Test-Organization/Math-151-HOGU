                </p>
              </li>
              <li>
                <p>
                  <m>y^2=4(x-1)</m>
                </p>
              </li>
              <li>
                <p>
                  <m>(y+4)^2=x-1</m>
                </p>
              </li>
            </ol>
        </statement>
        <answer>
          <p>
            (B)
          </p>
        </answer>
      </exercise>

