<article xml:id="week1" label="5837"> <!-- Change label to a random string of numbers for each worksheet. The label shows up in the url of the website and keeps students from searching for other worksheets -->
  <title>MATH 151 Hands-On, Grades Up</title>
  <introduction>
    <p>
     For workspace between exercises, print this worksheet or download to your device by clicking the printer icon.
    </p>
  </introduction>
<!--START TYPING CONTENT FOR SESSION BELOW HERE-->
  <worksheet>
    <title> Session #1 (Section 1.5, Appendix J.1)</title>
    <p>
      Directions: Answer each of the following as best you can. Feel free to discuss your thoughts about the questions with some peers around you.
    </p>
    <paragraphs> <!--   %%%%%%%%%%%%%%%%   SECTION 2  %%%%%%%%%%%%%%%%%    -->
      <title>Getting Warmed Up and in the Right Mindset</title>
      <exercise><!-- #1 -->
        <statement>
          <p>
            Let <m>\mathbf{a}=\langle x_1, y_1 \rangle</m> and <m>\mathbf{b}=\langle x_2, y_2 \rangle</m>. Match each formula, identity, or expression to its corresponding definition.
          </p>
          <sidebyside widths="82% 18%" valign="middle">
            <p>
              <ol marker="a)">
                <li>
                  <p>
                    The length of a vector <m>\mathbf{a}</m>, <m>|\mathbf{a}|</m>.
                  </p>
                </li>
                <li>
                  <p>
                    The unit vector pointing in the same direction as <m>\mathbf{a}</m>, <m>\hat{\mathbf{a}}</m>.
                  </p>
                </li>
                <li>
                  <p>
                    The vector perpendicular to the vector <m>\mathbf{a}</m>, <m>\mathbf{a}^{\perp}</m>.
                  </p>
                </li>
                <li>
                  <p>
                    The vector pointing from the tail of <m>\mathbf{a}</m> to the tip of <m>\mathbf{b}</m>.
                  </p>
                </li>
                <li>
                  <p>
                    The vector pointing from the tail of <m>\mathbf{b}</m> to the tip of <m>\mathbf{a}</m>.
                  </p>
                </li>
                <li>
                  <p>
                    The vector pointing from the tip of <m>\mathbf{a}</m> to the tip of <m>\mathbf{b}</m>, or the vector from the point <m>A=(x_1,y_1)</m> to the point <m>B=(x_2,y_2)</m>, <m>\overrightarrow{AB}</m>.
                  </p>
                </li>
                <li>
                  <p>
                    The vector pointing from the tip of <m>\mathbf{b}</m> to the tip of <m>\mathbf{a}</m>, or the vector from the point <m>A=(x_1,y_1)</m> to the point <m>B=(x_2,y_2)</m>, <m>\overrightarrow{BA}</m>.
                  </p>
                </li>
              </ol>
            </p>

            <p>
              <ol marker="I)">
                <li>
                  <p>
                    <m>\mathbf{b}+\mathbf{a}</m>
                  </p>
                </li>
                <li>
                  <p>
                    <m>\langle -y_1,x_1 \rangle</m>
                  </p>
                </li>
                <li>
                  <p>
                    <m>\mathbf{a}-\mathbf{b}</m>
                  </p>
                </li>
                <li>
                  <p>
                    <m>\mathbf{a}+\mathbf{b}</m>
                  </p>
                </li>
                <li>
                  <p>
                    <m>\sqrt{x_1^2+y_1^2}</m>
                  </p>
                </li>
                <li>
                  <p>
                    <m>\mathbf{b}-\mathbf{a}</m>
                  </p>
                </li>
                <li>
                  <p>
                    <m>\dfrac{\mathbf{a}}{|\mathbf{a}|}</m>
                  </p>
                </li>
              </ol>
            </p>
          </sidebyside>
        </statement>
        <answer>
          <p>
            a--V, b--VII, c--II, d--IV, e--I, f--VI, g--III
          </p>
        </answer>
      </exercise>
      <exercise><!-- #2 -->
        <statement>
          <p>
            Let <m>\mathbf{a}</m> and <m>\mathbf{b}</m> be given in the graph below.
            <image source="output/h1fig1" width="60%">
              <shortdescription>Graph of two vectors plotted on coordinate axes. Refer to image description for more detail.</shortdescription><!--This is what a screenreader reads. Do not include math mode here.-->
              <description><!--this is not automatically read by a screenreader, but user can navigate there. Math mode is acceptable here and paragraph environment must be included-->
                <p>
                A graph of two vectors plotted on coordinate axes with <m>x</m>-values ranging from <m>-10</m> to <m>10</m> and <m>y</m>-values ranging from <m>-10</m> to <m>10</m>. The first vector, <m>\mathbf{a}</m>, has a tip at coordinates <m>(3,4)</m> and a tail at <m>(0,0)</m>. The second vector, <m>\mathbf{b}</m>, has a tip at coordinates <m>(-6,6)</m> and a tail at <m>(0,0)</m>.
                </p>
              </description>
            </image>
          </p>
          <p>
            Draw and label the following on the graph: <m>-\mathbf{a}</m>, <m>-\mathbf{b}</m>, <m>2\mathbf{a}</m>, <m>\dfrac{1}{3}\mathbf{b}</m>, <m>\mathbf{a}+\mathbf{b}</m>, <m>\mathbf{a}-\mathbf{b}</m>, <m>\mathbf{b}-\mathbf{a}</m>.
          </p>
        </statement>
        <answer>
          <p>
            <image source="output/h1fig2" width="60%">
              <shortdescription>Graph of several plotted on coordinate axes. Refer to image description for more detail.</shortdescription><!--This is what a screenreader reads. Do not include math mode here.-->
              <description><!--this is not automatically read by a screenreader, but user can navigate there. Math mode is acceptable here and paragraph environment must be included-->
                <p>
                A graph of seven vectors, along with the two vectors from the question, plotted on coordinate axes with <m>x</m>-values ranging from <m>-10</m> to <m>10</m> and <m>y</m>-values ranging from <m>-10</m> to <m>10</m>. 
                The first vector, <m>-\mathbf{a}</m>, has a tip at coordinates <m>(-3,-4)</m>.
                The second vector, <m>-\mathbf{b}</m>, has a tip at coordinates <m>(6,-6)</m>.
                The third vector, <m>2\mathbf{a}</m>, has a tip at coordinates <m>(6,8)</m>.
                The fourth vector, <m>\dfrac{1}{3}\mathbf{b}</m>, has a tip at coordinates <m>(-2,2)</m>.
                The fifth vector, <m>\mathbf{a}+\mathbf{b}</m>, has a tip at coordinates <m>(-3,10)</m>.
                The sixth vector, <m>\mathbf{a}-\mathbf{b}</m>, has a tip at coordinates <m>(9,-2)</m>.
                The seventh vector, <m>\mathbf{b}-\mathbf{a}</m>, has a tip at coordinates <m>(-9,2)</m>.
                All vectors have a tail at coordinates <m>(0,0)</m>.
                </p>
              </description>
            </image>
          </p>
        </answer>
      </exercise>
    </paragraphs>
    <paragraphs><!--   %%%%%%%%%%%%%%%%   SECTION 2  %%%%%%%%%%%%%%%%%    -->
      <title>Let Us Get Our Hands On</title>
      <exercise number="1"><!-- #1 -->
        <introduction>
          <p>
            Consider vectors <m>\mathbf{a}=3\mathbf{i}+5\mathbf{j}</m> and <m>\mathbf{b}=2\mathbf{i}-4\mathbf{j}</m>
          </p>
        </introduction>
        <task workspace=".5in">
          <statement>
            <p>
              Find the resultant vector, <m>\mathbf{a}+\mathbf{b}</m>.
            </p>
          </statement>
          <answer>
            <p>
              <m>\mathbf{a}+\mathbf{b} = 5\mathbf{i}+\mathbf{j}</m>
            </p>
          </answer>
        </task>
        <task workspace=".5in">
          <statement>
            <p>
              Find the magnitudes (lengths) of the vectors <m>\mathbf{a}</m> and <m>\mathbf{b}</m>, <m>|\mathbf{a}|</m> and <m>|\mathbf{b}|</m> respectively.
            </p>
          </statement>
          <answer>
            <p>
              <m>|\mathbf{a}|=\sqrt{34}, |\mathbf{b}|=2\sqrt{5}</m>
            </p>
          </answer>
        </task>
        <task workspace=".5in">
          <statement>
            <p>
              Find the unit vectors pointing in the directions of <m>\mathbf{a}</m> and <m>\mathbf{b}</m>, <m>\hat{\mathbf{a}}</m> and <m>\hat{\mathbf{b}}</m> respectively.
            </p>
          </statement>
          <answer>
            <p>
              <m>\hat{\mathbf{a}}=\dfrac{3\sqrt{34}}{34}\mathbf{i}+\dfrac{5\sqrt{34}}{34}\mathbf{j}</m>, <m>\hat{\mathbf{b}}=\dfrac{\sqrt{5}}{5}\mathbf{i}-\dfrac{2\sqrt{5}}{5}\mathbf{j}</m>
            </p>
          </answer>
        </task>
      </exercise>
      <exercise number="2"><!-- #2 -->
        <introduction>
          <p>
            Two forces act on an object, as shown in the picture below.
            <image source="output/h1fig4" width="80%">
              <shortdescription>Two vectors pointing in different directions. Refer to image description for more detail.</shortdescription><!--This is what a screenreader reads. Do not include math mode here.-->
              <description><!--this is not automatically read by a screenreader, but user can navigate there. Math mode is acceptable here and paragraph environment must be included-->
                <p>
                Two vectors pointing in different directions. The first, <m>\mathbf{F}_1</m>, acts with a magnitude of <m>15\text{ N}</m> at an angle of <m>30^\circ</m> counterclockwise from the <m>x</m>-axis. The second, <m>\mathbf{F}_2</m>, acts with a magnitude of <m>8\text{ N}</m> at an angle of <m>135^\circ</m> counterclockwise from the <m>x</m>-axis.
                </p>
              </description>
            </image>
          </p>
          <p>
            The first, <m>\mathbf{F}_1</m>, acts with a magnitude of <m>15\text{ N}</m> at an angle of <m>30^\circ</m> counterclockwise from the <m>x</m>-axis. The second, <m>\mathbf{F}_2</m>, acts with a magnitude of <m>8\text{ N}</m> at an angle of <m>135^\circ</m> counterclockwise from the <m>x</m>-axis. You may leave your answers to the following problems in terms of inverse trigonometric functions, if applicable.
          </p>
        </introduction>
        <task workspace=".5in">
          <statement>
            <p>
              Find the magnitude of the resulting force.
            </p>
          </statement>
          <answer>
            <p>
              <m>|\mathbf{F}_{\text{net}}|=\sqrt{\left(\dfrac{15\sqrt{3}}{2}-4\sqrt{2}\right)^2+\left(\dfrac{15}{2}+4\sqrt{2}\right)^2}\text{ N}</m>
            </p>
          </answer>
        </task>
        <task workspace=".5in">
          <statement>
            <p>
              Find the angle that the resultant force makes with the <m>x</m>-axis.
            </p>
          </statement>
          <answer>
            <p>
              <m>\theta=\arctan\left(\dfrac{\frac{15}{2}+4\sqrt{2}}{\frac{15\sqrt{3}}{2}-4\sqrt{2}}\right)\text{ degrees}</m>
            </p>
          </answer>
        </task>
      </exercise>
      <exercise number="3"><!-- #3 -->
        <introduction>
          <p>
            A mass is suspended at rest by two identical, rigid, massless strings that make an angle of <m>45</m> degrees with the horizontal. Gravity exerts a <m>10\text{ N}</m> force on the mass directly downward.
          </p>
        </introduction>
        <task workspace=".5in">
          <statement>
            <p>
              Draw a diagram for this problem
            </p>
          </statement>
          <answer>
          <p>
            <image source="output/h1fig3" width="80%">
              <shortdescription>A mass suspended at rest by two identical, rigid, massless strings. Refer to image description for more detail.</shortdescription><!--This is what a screenreader reads. Do not include math mode here.-->
              <description><!--this is not automatically read by a screenreader, but user can navigate there. Math mode is acceptable here and paragraph environment must be included-->
                <p>
                A mass suspended at rest by two identical, rigid, massless strings that make an angle of <m>45</m> degrees with the horizontal. Gravity exerts a <m>10\text{ N}</m> force on the mass directly downward.
                </p>
              </description>
            </image>
          </p>
        </answer>
        </task>
        <task workspace=".5in">
          <statement>
            <p>
              What is the magnitude of the tension in each of the strings?
            </p>
          </statement>
          <answer>
            <p>
              <m>|\mathbf{T}_1| = |\mathbf{T}_2| = 5\sqrt{2}\text{ N}</m>
            </p>
          </answer>
        </task>
        <task workspace=".5in">
          <statement>
            <p>
              Determine the horizontal components for the force of tension in each of the strings.
            </p>
          </statement>
          <answer>
            <p>
              <m>\mathbf{T}_{x,1}=-5\text{ N}</m>, <m>\mathbf{T}_{x,2}=5\text{ N}</m>
            </p>
          </answer>
        </task>
      </exercise>
      <exercise number="4"><!-- #4 -->
        <introduction>
          <p>
            Simplify the following trigonometric expressions to algebraic expressions involving <m>x</m> only.
          </p>
        </introduction>
        <task workspace=".5in">
          <statement>
            <p>
              <m>\sin(\arcsin(x))</m>
            </p>
          </statement>
          <answer>
            <p>
              <m>\sin(\arcsin(x))=x</m>
            </p>
          </answer>
        </task>
        <task workspace=".5in">
          <statement>
            <p>
              <m>\cos(\arcsin(x))</m>
            </p>
          </statement>
          <answer>
            <p>
              <m>\cos(\arcsin(x))=\sqrt{1-x^2}</m>
            </p>
          </answer>
        </task>
        <task workspace=".5in">
          <statement>
            <p>
              <m>\tan\left(\arcsin\left(\dfrac{x}{2}\right)\right)</m>
            </p>
          </statement>
          <answer>
            <p>
              <m>\tan\left(\arcsin\left(\dfrac{x}{2}\right)\right)=\dfrac{x}{\sqrt{4-x^2}}</m>
            </p>
          </answer>
        </task>
        <task workspace=".5in">
          <statement>
            <p>
              <m>\tan\left(\arccos\left(\dfrac{x}{3}\right)\right)</m>
            </p>
          </statement>
          <answer>
            <p>
              <m>\tan\left(\arccos\left(\dfrac{x}{3}\right)\right)=\dfrac{\sqrt{9-x^2}}{x}</m>
            </p>
          </answer>
        </task>
      </exercise>
      <exercise number="5"><!-- #5 -->
        <introduction>
          <p>
            Find the exact values of the following inverse trigonometric functions using any method. If the indicated expression doesn't exist, write DNE. Be careful of any possible domain restrictions.
          </p>
        </introduction>
        <task workspace=".5in">
          <statement>
            <p>
              <m>\arcsin\left(\sin\left(\dfrac{3\pi}{2}\right)\right)</m>
            </p>
          </statement>
          <answer>
            <p>
              <m>\arcsin\left(\sin\left(\dfrac{3\pi}{2}\right)\right) = -\dfrac{\pi}{2}</m>
            </p>
          </answer>
        </task>
        <task workspace=".5in">
          <statement>
            <p>
              <m>\arcsin\left(\cos\left(-\dfrac{11\pi}{6}\right)\right)</m>
            </p>
          </statement>
          <answer>
            <p>
              <m>\arcsin\left(\cos\left(-\dfrac{11\pi}{6}\right)\right) = \dfrac{\pi}{6}</m>
            </p>
          </answer>
        </task>
        <task workspace=".5in">
          <statement>
            <p>
              <m>\arctan\left(\tan\left(\dfrac{3\pi}{4}\right)\right)</m>
            </p>
          </statement>
          <answer>
            <p>
              <m>\arctan\left(\tan\left(\dfrac{3\pi}{4}\right)\right) = -\dfrac{\pi}{4}</m>
            </p>
          </answer>
        </task>
        <task workspace=".5in">
          <statement>
            <p>
              <m>\arcsin\left(\tan\left(\dfrac{\pi}{2}\right)\right)</m>
            </p>
          </statement>
          <answer>
            <p>
              <m>\arcsin\left(\tan\left(\dfrac{\pi}{2}\right)\right) = \text{DNE}</m>
            </p>
          </answer>
        </task>
        <task workspace=".5in">
          <statement>
            <p>
              <m>\arccos\left(\sin\left(\dfrac{-7\pi}{6}\right)\right)</m>
            </p>
          </statement>
          <answer>
            <p>
              <m>\arccos\left(\sin\left(\dfrac{-7\pi}{6}\right)\right) = \dfrac{\pi}{3}</m>
            </p>
          </answer>
        </task>
        <task workspace=".5in">
          <statement>
            <p>
              <m>\arctan\left(\cos\left(\dfrac{5\pi}{4}\right)\right)</m>
            </p>
          </statement>
          <answer>
            <p>
              <m>\arctan\left(\cos\left(\dfrac{5\pi}{4}\right)\right) = \arctan\left(-\dfrac{\sqrt{2}}{2}\right)</m>
            </p>
          </answer>
        </task>
      </exercise>
    </paragraphs>

    <paragraphs><!--   %%%%%%%%%%%%%%%%   SECTION 3  %%%%%%%%%%%%%%%%%    -->
      <title>Now Grades Go Up</title>
      
      <exercise number="1"><!-- #1 -->
        <statement>
          <p>
            Which of the following is a unit vector perpendicular to the vector <m>\langle 3,4 \rangle</m>?
          </p>
            <ol marker="(A)">
              <li>
                <p>
                  <m>\left\langle \dfrac{4}{5},\dfrac{3}{5} \right\rangle</m>
                </p>
              </li>
              <li>
                <p>
                  <m>\left\langle -\dfrac{4}{5},-\dfrac{3}{5} \right\rangle</m>
                </p>
              </li>
              <li>
                <p>
                  <m>\left\langle \dfrac{3}{5},\dfrac{4}{5} \right\rangle</m>
                </p>
              </li>
              <li>
                <p>
                  <m>\left\langle -\dfrac{3}{5},-\dfrac{4}{5} \right\rangle</m>
                </p>
              </li>
              <li>
                <p>
                  <m>\left\langle -\dfrac{4}{5},\dfrac{3}{5} \right\rangle</m>
                </p>
              </li>
            </ol>
        </statement>
        <answer>
          <p>
            (E)
          </p>
        </answer>
      </exercise>

      <exercise number="2"><!-- #2 -->
        <statement>
          <p>
            If <m>\mathbf{a}=4\mathbf{i}+2\mathbf{j}</m>, <m>\mathbf{b}=-3\mathbf{i}+\mathbf{j}</m>, and <m>\mathbf{c}=2\mathbf{i}-\mathbf{j}</m>, find <m>2\mathbf{a}-3\mathbf{b}+\mathbf{c}</m>.
          </p>
            <ol marker="(A)">
              <li>
                <p>
                  <m>19\mathbf{i}</m>
                </p>
              </li>
              <li>
                <p>
                  <m>17\mathbf{i}+\mathbf{j}</m>
                </p>
              </li>
              <li>
                <p>
                  <m>19\mathbf{i}+\mathbf{j}</m>
                </p>
              </li>
              <li>
                <p>
                  <m>14\mathbf{i}-\mathbf{j}</m>
                </p>
              </li>
              <li>
                <p>
                  <m>14\mathbf{i}+\mathbf{j}</m>
                </p>
              </li>
            </ol>
        </statement>
        <answer>
          <p>
            (A)
          </p>
        </answer>
      </exercise>

      <exercise number="3"><!-- #3 -->
        <statement>
          <p>
            A racecar driver drives their car at a speed of <m>180\ \text{ mi/hr}</m> with a bearing <m>\text{N}45^\circ\text{E}</m> under normal conditions. Today, a strong wind is blowing at a speed of <m>20\ \text{ mi/hr}</m> with a bearing <m>\text{S}60^\circ\text{W}</m>. Find the resultant velocity vector of the car.
          </p>
            <ol marker="(A)">
              <li>
                <p>
                  <m>\left\langle 90\sqrt{2}+10\sqrt{3}, 90\sqrt{2}-10 \right\rangle</m>
                </p>
              </li>
              <li>
                <p>
                  <m>\left\langle 90\sqrt{2}-10\sqrt{3}, 90\sqrt{2}+10 \right\rangle</m>
                </p>
              </li>
              <li>
                <p>
                  <m>\left\langle 90\sqrt{2}-20\sqrt{3}, 90\sqrt{2}-20 \right\rangle</m>
                </p>
              </li>
              <li>
              <p>
                <m>\left\langle 90\sqrt{2}-10, 90\sqrt{2}-10\sqrt{3} \right\rangle</m>
              </p>
              </li>
              <li>
                <p>
                  <m>\left\langle 90\sqrt{2}-10\sqrt{3}, 90\sqrt{2}-10 \right\rangle</m>
                </p>
              </li>
            </ol>
        </statement>
        <answer>
          <p>
            (E)
          </p>
        </answer>
      </exercise>
      <exercise number="4"><!-- #4 -->
        <statement>
          <p>
            Let <m>A = (-1,2)</m> and <m>B = (4,1)</m>. Find the vector of length <m>2</m> pointing in the same direction as <m>\overrightarrow{AB}</m>.
          </p>
            <ol marker="(A)">
              <li>
                <p>
                  <m>\left\langle \dfrac{10}{13},\dfrac{2}{13} \right\rangle</m>
                </p>
              </li>
              <li>
                <p>
                  <m>\left\langle \dfrac{10}{13},-\dfrac{2}{13} \right\rangle</m>
                </p>
              </li>
              <li>
                <p>
                  <m>\left\langle \dfrac{10}{\sqrt{26}},-\dfrac{2}{\sqrt{26}} \right\rangle</m>
                </p>
              </li>
              <li>
                <p>
                  <m>\left\langle \dfrac{10}{\sqrt{26}},\dfrac{2}{\sqrt{26}} \right\rangle</m>
                </p>
              </li>
              <li>
                <p>
                  <m>\left\langle -\dfrac{10}{\sqrt{26}},\dfrac{2}{\sqrt{26}} \right\rangle</m>
                </p>
              </li>
            </ol>
        </statement>
        <answer>
          <p>
            (C)
          </p>
        </answer>
      </exercise>
      <exercise number="5"><!-- #5 -->
        <statement>
          <p>
            Simplify <m>\cos(\arctan(2x))</m> to an algebraic expression involving <m>x</m> only.
          </p>
            <ol marker="(A)">
              <li>
                <p>
                  <m>\dfrac{1}{\sqrt{4x^2+1}}</m>
                </p>
              </li>
              <li>
                <p>
                  <m>\dfrac{1}{\sqrt{1-4x^2}}</m>
                </p>
              </li>
              <li>
                <p>
                  <m>\dfrac{2x}{\sqrt{4x^2+1}}</m>
                </p>
              </li>
              <li>
                <p>
                  <m>\dfrac{2x}{\sqrt{1-4x^2}}</m>
                </p>
              </li>
              <li>
                <p>
                  <m>\sqrt{4x^2+1}</m>
                </p>
              </li>
            </ol>
        </statement>
        <answer>
          <p>
            (A)
          </p>
        </answer>
      </exercise>
      <exercise number="6"><!-- #6 -->
        <statement>
          <p>
            Simplify <m>\sec\left(\arctan\left(\dfrac{x}{2}\right)\right)</m> to an algebraic expression involving <m>x</m> only.
          </p>
            <ol marker="(A)">
              <li>
                <p>
                  <m>\dfrac{\sqrt{x^2+4}}{x}</m>
                </p>
              </li>
              <li>
                <p>
                  <m>\dfrac{x}{2}</m>
                </p>
              </li>
              <li>
                <p>
                  <m>\dfrac{2}{\sqrt{x^2+4}}</m>
                </p>
              </li>
              <li>
                <p>
                  <m>\dfrac{\sqrt{x^2+4}}{2}</m>
                </p>
              </li>
              <li>
                <p>
                  <m>\dfrac{x}{\sqrt{x^2+4}}</m>
                </p>
              </li>
            </ol>
        </statement>
        <answer>
          <p>
            (D)
          </p>
        </answer>
      </exercise>
      <exercise number="7"><!-- #7 -->
        <statement>
          <p>
            Simplify <m>\cos(\arctan(-1))</m>.
          </p>
            <ol marker="(A)">
              <li>
                <p>
                  <m>-1</m>
                </p>
              </li>
              <li>
                <p>
                  <m>\dfrac{\sqrt{2}}{2}</m>
                </p>
              </li>
              <li>
                <p>
                  <m>-\dfrac{\sqrt{2}}{2}</m>
                </p>
              </li>
              <li>
                <p>
                  <m>\dfrac{\sqrt{3}}{2}</m>
                </p>
              </li>
              <li>
                <p>
                  <m>-\dfrac{\sqrt{3}}{2}</m>
                </p>
              </li>
            </ol>
        </statement>
        <answer>
          <p>
            (B)
          </p>
        </answer>
      </exercise>
    </paragraphs>
  
  </worksheet>

</article>

