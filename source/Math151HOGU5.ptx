                    </row>
                </tabular>
            </table>
            Use the table above to find <m>h'(0)</m> if <m>h'(x)=-g(f(x))</m>.
          </p>
            <ol marker="(A)">
              <li>
                <p>
                  <m>h'(0)=-3</m>
                </p>
              </li>
              <li>
                <p>
                  <m>h'(0)=-2</m>
                </p>
              </li>
              <li>
                <p>
                  <m>h'(0)=-1</m>
                </p>
              </li>
              <li>
                <p>
                  <m>h'(0)=0</m>
                </p>
              </li>
              <li>
                <p>
                  <m>h'(0)=1</m>
                </p>
              </li>
            </ol>
        </statement>
        <answer>
          <p>
            (A)
          </p>
        </answer>
      </exercise>

      <exercise number="8"><!-- #8 -->
        <statement>
          <p>
            Find the <m>2027</m>th derivative of <m>f(x)=2xe^{2x}</m>.
          </p>
            <ol marker="(A)">
              <li>
                <p>
                  <m>f^{(2027)}(x)=2026\cdot 2^{2027}xe^{2x}+2^{2026}e^{2x}</m>
                </p>
              </li>
              <li>
                <p>
                  <m>f^{(2027)}(x)=2^{2027}xe^{2x}+2028\cdot 2^{2028}e^{2x}</m>
                </p>
              </li>
              <li>
                <p>
                  <m>f^{(2027)}(x)=2^{2027}xe^{2x}+2027\cdot 2^{2027}e^{2x}</m>
                </p>
              </li>
              <li>
                <p>
                  <m>f^{(2027)}(x)=2^{2028}xe^{2x}+2027\cdot 2^{2027}e^{2x}</m>
                </p>
              </li>
              <li>
                <p>
                  <m>f^{(2027)}(x)=2^{2028}xe^{2x}+2028\cdot 2^{2028}e^{2x}</m>
                </p>
              </li>
            </ol>
        </statement>
        <answer>
          <p>
            (D)
          </p>
        </answer>
      </exercise>
