              </li>
              <li>
                <p>
                  <m>\dfrac{1}{3}</m>
                </p>
              </li>
              <li>
                <p>
                  <m>1</m>
                </p>
              </li>
              <li>
                <p>
                  <m>-\infty</m>
                </p>
              </li>
            </ol>
        </statement>
        <answer>
          <p>
            (A)
          </p>
        </answer>
      </exercise>

      <exercise number="18"><!-- #18 -->
