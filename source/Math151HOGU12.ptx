      <exercise number="26"><!-- #26 -->
        <statement>
          <p>
            A population of phytoplankton (which grows at a rate proportional to its population size) initially contains <m>10</m> million organisms and doubles every <m>12</m> hours. Find the rate of change of the number of phytoplankton present after <m>3</m> days.
          </p>
            <ol marker="(A)">
              <li>
                <p>
                  <m>80\ln(2)</m> million organisms per day
                </p>
              </li>
              <li>
                <p>
                  <m>160\ln(2)</m> million organisms per day
                </p>
              </li>
              <li>
                <p>
                  <m>320\ln(2)</m> million organisms per day
                </p>
              </li>
              <li>
                <p>
                  <m>640\ln(2)</m> million organisms per day
                </p>
              </li>
              <li>
                <p>
                  <m>1280\ln(2)</m> million organisms per day
                </p>
              </li>
            </ol>
        </statement>
        <answer>
          <p>
            (E)
          </p>
        </answer>
      </exercise>
