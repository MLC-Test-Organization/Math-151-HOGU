      <exercise number="19"><!-- #19 -->
        <statement>
          <p>
            Find the <m>2029</m>th derivative of <m>f(x)=\dfrac{1}{2}x\cos(2x)</m>.
          </p>
            <ol marker="(A)">
              <li>
                <p>
                  <m>f^{(2029)}(x)=2029\cdot2^{2027}\cos(2x)-2^{2028}x\sin(2x)</m>
                </p>
              </li>
              <li>
                <p>
                  <m>f^{(2029)}(x)=-2029\cdot2^{2027}\cos(2x)+2^{2028}x\sin(2x)</m>
                </p>
              </li>
              <li>
                <p>
                  <m>f^{(2029)}(x)=2029\cdot2^{2027}\sin(2x)-2^{2028}x\cos(2x)</m>
                </p>
              </li>
              <li>
                <p>
                  <m>f^{(2029)}(x)=-2029\cdot2^{2027}\cos(2x)+2^{2028}x\cos(2x)</m>
                </p>
              </li>
              <li>
                <p>
                  <m>f^{(2029)}(x)=2029\cdot2^{2027}\sin(2x)-2^{2028}x\sin(2x)</m>
                </p>
              </li>
            </ol>
        </statement>
        <answer>
          <p>
            (A)
          </p>
        </answer>
      </exercise>

      <exercise number="20"><!-- #20 -->
        <statement>
          <p>
            Use the table below to find <m>h'(1)</m> if <m>h(x)=-\dfrac{g(f(x))}{f(x)}</m>.
              <table>
                <tabular halign="center">
                    <row header="yes" bottom="minor">
                        <cell><m>x</m></cell>
                        <cell><m>f(x)</m></cell>
                        <cell><m>g(x)</m></cell>
                        <cell><m>f'(x)</m></cell>
                        <cell><m>g'(x)</m></cell>
                    </row>
                    <row bottom="minor">
                        <cell><m>-3</m></cell>
                        <cell><m>-3</m></cell>
                        <cell><m>-1</m></cell>
                        <cell><m>0</m></cell>
                        <cell><m>3</m></cell>
                    </row>
                    <row bottom="minor">
                        <cell><m>-2</m></cell>
                        <cell><m>0</m></cell>
                        <cell><m>-3</m></cell>
                        <cell><m>2</m></cell>
                        <cell><m>-2</m></cell>
                    </row>
                    <row bottom="minor">
                        <cell><m>-1</m></cell>
                        <cell><m>1</m></cell>
                        <cell><m>2</m></cell>
                        <cell><m>1</m></cell>
                        <cell><m>0</m></cell>
                    </row>
                    <row bottom="minor">
                        <cell><m>0</m></cell>
                        <cell><m>1</m></cell>
                        <cell><m>0</m></cell>
                        <cell><m>-2</m></cell>
                        <cell><m>2</m></cell>
                    </row>
                    <row bottom="minor">
                        <cell><m>1</m></cell>
                        <cell><m>3</m></cell>
                        <cell><m>-1</m></cell>
                        <cell><m>-3</m></cell>
                        <cell><m>3</m></cell>
                    </row>
                    <row bottom="minor">
                        <cell><m>2</m></cell>
                        <cell><m>2</m></cell>
                        <cell><m>-1</m></cell>
                        <cell><m>2</m></cell>
                        <cell><m>1</m></cell>
                    </row>
                    <row bottom="medium">
                        <cell><m>3</m></cell>
                        <cell><m>0</m></cell>
                        <cell><m>-2</m></cell>
                        <cell><m>3</m></cell>
                        <cell><m>-1</m></cell>
                    </row>
                </tabular>
            </table>
          </p>
            <ol marker="(A)">
              <li>
                <p>
                  <m>h'(1)=-\dfrac{1}{3}</m>
                </p>
              </li>
              <li>
                <p>
                  <m>h'(1)=-\dfrac{1}{6}</m>
                </p>
              </li>
              <li>
                <p>
                  <m>h'(1)=-\dfrac{1}{9}</m>
                </p>
              </li>
              <li>
                <p>
                  <m>h'(1)=0</m>
                </p>
              </li>
              <li>
                <p>
                  <m>h'(1)=1</m>
                </p>
              </li>
            </ol>
        </statement>
        <answer>
          <p>
            (A)
          </p>
        </answer>
      </exercise>

      <exercise number="21"><!-- #21 -->
        <statement>
          <p>
            Find <m>\dfrac{dy}{dx}</m> if <m>y=2x^3y^2-3x^2y^3=5e^{xy}</m>.
          </p>
            <ol marker="(A)">
              <li>
                <p>
                  <m>\dfrac{dy}{dx}=\dfrac{6xy^3+6x^2y^2+5e^{xy}}{4x^2y-9x^2y^2-5e^{xy}}</m>
                </p>
              </li>
              <li>
                <p>
                  <m>\dfrac{dy}{dx}=\dfrac{6xy^3-6x^2y^2+5e^{xy}}{4x^2y-9x^2y^2-5e^{xy}}</m>
                </p>
              </li>
              <li>
                <p>
                  <m>\dfrac{dy}{dx}=\dfrac{-6xy^3-6x^2y^2+5e^{xy}}{4x^2y+9x^2y^2-5e^{xy}}</m>
                </p>
              </li>
              <li>
                <p>
                  <m>\dfrac{dy}{dx}=\dfrac{6xy^3-6x^2y^2+5e^{xy}}{-4x^2y+9x^2y^2-5e^{xy}}</m>
                </p>
              </li>
              <li>
                <p>
                  <m>\dfrac{dy}{dx}=\dfrac{-6xy^3+6x^2y^2+5e^{xy}}{4x^2y+9x^2y^2-5e^{xy}}</m>
                </p>
              </li>
            </ol>
        </statement>
        <answer>
          <p>
            (B)
          </p>
        </answer>
      </exercise>

      <exercise number="22"><!-- #22 -->
        <statement>
          <p>
            Find the <m>t</m>-value(s) where the parametric curve given by <m>x(t)=2t^3-9t^2+12t+7</m> and <m>y(t)=t^3+\dfrac{9}{2}t^2-12t+5</m> has a vertical or horizontal tangent line.
          </p>
            <ol marker="(A)">
              <li>
                <p>
                  Vertical Tangent at <m>t=-4</m>, Horizontal Tangent at <m>t=1,2</m>
                </p>
              </li>
              <li>
                <p>
                  Vertical Tangent at <m>t=-4,2</m>, Horizontal Tangent at <m>t=1</m>
                </p>
              </li>
              <li>
                <p>
                  Vertical Tangent at <m>t=1</m>, Horizontal Tangent at <m>t=-4</m>
                </p>
              </li>
              <li>
                <p>
                  Vertical Tangent at <m>t=1,2</m>, Horizontal Tangent at <m>t=-4</m>
                </p>
              </li>
              <li>
                <p>
                  Vertical Tangent at <m>t=2</m>, Horizontal Tangent at <m>t=-4</m>
                </p>
              </li>
            </ol>
        </statement>
        <answer>
          <p>
            (E)
          </p>
        </answer>
      </exercise>

      <exercise number="23"><!-- #23 -->
        <statement>
          <p>
            The displacement of a particle, measured in meters, is given by <m>s(t)=-2t^3+3t+5</m> where <m>t\geq 0</m>, representing time, is measured in seconds. Find the average velocity of the particle on the interval <m>[-1,1]</m>.
          </p>
            <ol marker="(A)">
              <li>
                <p>
                  <m>-2\frac{\text{m}}{\text{s}}</m>
                </p>
              </li>
              <li>
                <p>
                  <m>-1\frac{\text{m}}{\text{s}}</m>
                </p>
              </li>
              <li>
                <p>
                  <m>1\frac{\text{m}}{\text{s}}</m>
                </p>
              </li>
              <li>
                <p>
                  <m>3\frac{\text{m}}{\text{s}}</m>
                </p>
              </li>
              <li>
                <p>
                  <m>5\frac{\text{m}}{\text{s}}</m>
                </p>
              </li>
            </ol>
        </statement>
        <answer>
          <p>
            (C)
          </p>
        </answer>
      </exercise>

