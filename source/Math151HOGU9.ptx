<article xml:id="week9" label="0009"> <!-- Change label to a random string of numbers for each worksheet. The label shows up in the url of the website and keeps students from searching for other worksheets -->
  <title>MATH 151 Hands-On, Grades Up</title>
  <introduction>
    <p>
     For workspace between exercises, print this worksheet or download to your device by clicking the printer icon.
    </p>
  </introduction>
<!--START TYPING CONTENT FOR SESSION BELOW HERE-->
  <worksheet>
    <title> Session #9 (Sections 4.4, 4.7, &amp; 4.9)</title>
    <p>
      Directions: Answer each of the following as best you can. Feel free to discuss your thoughts about the questions with some peers around you.
    </p>
    <paragraphs> <!--   %%%%%%%%%%%%%%%%   SECTION 2  %%%%%%%%%%%%%%%%%    -->
      <title>Getting Warmed Up and in the Right Mindset</title>
      <exercise><!-- #1 -->
        <statement>
          <p>
            Match each graph of a function on the left to its antiderivative on the right.
          </p>
          <sidebyside widths="82% 18%" valign="middle">
            <p>
              <ol marker="a)">
                <li>
                  <p>
                    <m></m>
                  </p>
                </li>
                <li>
                  <p>
                    <m></m>
                  </p>
                </li>
                <li>
                  <p>
                    <m></m>
                  </p>
                </li>
                <li>
                  <p>
                    <m></m>
                  </p>
                </li>
                <li>
                  <p>
                    <m></m>
                  </p>
                </li>
                <li>
                  <p>
                    <m></m>
                  </p>
                </li>
              </ol>
            </p>

            <p>
              <ol marker="I)">
                <li>
                  <p>
                    <m></m>
                  </p>
                </li>
                <li>
                  <p>
                    <m></m>
                  </p>
                </li>
                <li>
                  <p>
                    <m></m>
                  </p>
                </li>
                <li>
                  <p>
                    <m></m>
                  </p>
                </li>
                <li>
                  <p>
                    <m></m>
                  </p>
                </li>
                <li>
                  <p>
                    <m></m>
                  </p>
                </li>
              </ol>
            </p>
          </sidebyside>
        </statement>
        <answer>
          <p>
            a--IV, b--III, c--V, d--I, e--II, f--VI
          </p>
        </answer>
      </exercise>
      <exercise><!-- #2 -->
          <statement>
            <p>
              OPTIMIZATION?
            </p>
          </statement>
      </exercise>
    </paragraphs>
    <paragraphs><!--   %%%%%%%%%%%%%%%%   SECTION 2  %%%%%%%%%%%%%%%%%    -->
      <title>Let Us Get Our Hands On</title>
      <exercise number="1"><!-- #1 -->
        <introduction>
          <p>
            Use L'Hospital's rule to evaluate the following limits. If a limit does not exist, and does not tend toward <m>\pm \infty</m>, write 'DNE'.
          </p>
        </introduction>
        <task>
          <statement>
            <p>
              <m>\lim_{x\rightarrow 3}\dfrac{x^2-9}{x-3}</m>
            </p>
          </statement>
          <answer>
            <p>
              <m>6</m>
            </p>
          </answer>
        </task>
        <task>
          <statement>
            <p>
              <m>\lim_{x\rightarrow \infty}x^2e^{-x}</m>
            </p>
          </statement>
          <answer>
            <p>
              <m>0</m>
            </p>
          </answer>
        </task>
        <task>
          <statement>
            <p>
              <m>\lim_{x\rightarrow \frac{\pi}{2}}\dfrac{\cos(x)}{x-\dfrac{\pi}{2}}</m>
            </p>
          </statement>
          <answer>
            <p>
              <m>-1</m>
            </p>
          </answer>
        </task>
        <task>
          <statement>
            <p>
              <m>\lim_{x\rightarrow 0}\dfrac{1}{x}-\dfrac{1}{\sin(x)}</m>
            </p>
          </statement>
          <answer>
            <p>
              <m>0</m>
            </p>
          </answer>
        </task>
        <task>
          <statement>
            <p>
              <m>\lim_{x\rightarrow 0}\dfrac{e^x-\cos(x)-x}{x^3}</m>
            </p>
          </statement>
          <answer>
            <p>
              DNE
            </p>
          </answer>
        </task>
        <task>
          <statement>
            <p>
              <m>\lim_{x\rightarrow \infty}\left(1+\dfrac{1}{\sqrt{x}}\right)^{\sqrt{x}}</m>
            </p>
          </statement>
          <answer>
            <p>
              <m>e</m>
            </p>
          </answer>
        </task>
      </exercise>
      <exercise number="2"><!-- #2 -->
          <statement>
            <p>
                A cardboard box with an open top is constructed by cutting squares out of the corners of a sheet of cardboard and folding the sides upward, as shown in the image below.
                IMAGE
                The cardboard sheet is <m>6</m> inches long and <m>16</m> inches wide. What is the maximum volume of the box?
            </p>
          </statement>
          <answer>
            <p>
              <m>\dfrac{1600}{27}\ \text{in}^2</m>
            </p>
          </answer>
      </exercise>
      <exercise number="3"><!-- #3 -->
          <statement>
            <p>
                You wish to cross a river <m>3</m> km across, to a point on the other bank <m>5</m> km directly in front of you, pictured below.
                
                Your walking speed on land is <m>5\frac{\text{km}}{\text{hr}}</m>, and your swimming speed is <m>5\frac{\text{km}}{\text{hr}}</m>. At what point should you start swimming to make it to the other bank as quickly as possible?
            </p>
          </statement>
          <answer>
            <p>
              <m>1</m> km
            </p>
          </answer>
      </exercise>
      <exercise number="4"><!-- #4 -->
          <statement>
            <p>
                A cylindrical can made by wrapping a rectangular piece of aluminum and placing a circular piece of aluminum on the top and bottom, pictured below.

                The cost of aluminum is <m>4</m> cents per <m>\text{in}^2</m>. The has a volume of <m>27\ \text{in}^3</m>. What are the dimensions of the can which minimize the total cost?""
            </p>
          </statement>
          <answer>
            <p>
              <m>r=\dfrac{3}{\sqrt[3]{2\pi}}</m>, <m>h=\dfrac{27}{\pi\left(\dfrac{3}{\sqrt[3]{2\pi}}\right)}</m>
            </p>
          </answer>
      </exercise>
        <exercise number="5"><!-- #5 -->
          <statement>
            <p>
                A farmer wants to construct a rectangular pen for their livestock with two dividers, creating three symmetric rectangular sub-pens, pictured below.

                The fencing for the perimeter costs <m>$5</m> per foot. The fencing for the dividers costs <m>$3</m> per foot. If the farmer has <m>$1000</m> to spend on fencing, find the dimensions of the pen which maximize the enclosed area.
            </p>
          </statement>
          <answer>
            <p>
              <m>L=\dfrac{125}{4}</m> ft, <m>W=50</m> ft
            </p>
          </answer>
      </exercise>
        <exercise number="6"><!-- #6 -->
        <introduction>
          <p>
            Find the most general antiderivative of each of the following functions.
          </p>
        </introduction>
        <task>
          <statement>
            <p>
              <m>f(x)=2-2x</m>
            </p>
          </statement>
          <answer>
            <p>
              <m>F(x)=2x-x^2+C</m>
            </p>
          </answer>
        </task>
        <task>
          <statement>
            <p>
              <m>g(t)=3t^2-2t+1</m>
            </p>
          </statement>
          <answer>
            <p>
              <m>G(t)=t^3-t^2+t+C</m>
            </p>
          </answer>
        </task>
        <task>
          <statement>
            <p>
              <m>p(x)=-3x^{\frac{1}{2}}</m>
            </p>
          </statement>
          <answer>
            <p>
              <m>P(x)=-2x^{\frac{3}{2}}+\dfrac{3}{2}x^{\frac{4}{3}}+C</m>
            </p>
          </answer>
        </task>
        <task>
          <statement>
            <p>
              <m>q(t)=3e^t-\csc^2(t)</m>
            </p>
          </statement>
          <answer>
            <p>
              <m>3e^t+\cot(t)+C</m>
            </p>
          </answer>
        </task>
        </exercise>
    </paragraphs>

    <paragraphs><!--   %%%%%%%%%%%%%%%%   SECTION 3  %%%%%%%%%%%%%%%%%    -->
      <title>Now Grades Go Up</title>
      
      <exercise number="1"><!-- #1 -->
        <statement>
          <p>
            Evaluete <m>\lim_{x\rightarrow\infty}\left(1+\dfrac{1}{x}\right)^{x+1}</m>.
          </p>
            <ol marker="(A)">
              <li>
                <p>
                  <m>-\infty</m>
                </p>
              </li>
              <li>
                <p>
                  <m>1</m>
                </p>
              </li>
              <li>
                <p>
                  <m>e</m>
                </p>
              </li>
              <li>
                <p>
                  <m>e^2</m>
                </p>
              </li>
              <li>
                <p>
                  <m>\infty</m>
                </p>
              </li>
            </ol>
        </statement>
        <answer>
          <p>
            (C)
          </p>
        </answer>
      </exercise>

      <exercise number="2"><!-- #2 -->
        <statement>
          <p>
            Evaluate <m>\lim_{x\rightarrow 1}\dfrac{\sin(\ln(x))}{x-1}</m>.
          </p>
            <ol marker="(A)">
              <li>
                <p>
                  <m>-\infty</m>
                </p>
              </li>
              <li>
                <p>
                  <m>-1</m>
                </p>
              </li>
              <li>
                <p>
                  <m>0</m>
                </p>
              </li>
              <li>
                <p>
                  <m>1</m>
                </p>
              </li>
              <li>
                <p>
                  <m>\infty</m>
                </p>
              </li>
            </ol>
        </statement>
        <answer>
          <p>
            (D)
          </p>
        </answer>
      </exercise>

      <exercise number="3"><!-- #3 -->
        <statement>
          <p>
            Evaluate <m>\lim_{x\rightrarrow 0}x^{\tan(x)}</m>.
          </p>
            <ol marker="(A)">
              <li>
                <p>
                  <m>-\infty</m>
                </p>
              </li>
              <li>
                <p>
                  <m>-1</m>
                </p>
              </li>
              <li>
                <p>
                  <m>0</m>
                </p>
              </li>
              <li>
                <p>
                  <m>1</m>
                </p>
              </li>
              <li>
                <p>
                  <m>\infty</m>
                </p>
              </li>
            </ol>
        </statement>
        <answer>
          <p>
            (D)
          </p>
        </answer>
      </exercise>

      <exercise number="4"><!-- #4 -->
        <statement>
          <p>
            A poster is to be printed with <m>4</m>-inch margins on the top and bottom, and <m>1</m>-inch margins on both sides. The total area of the poster is <m>900\ \text{in}^2</m>. Find the dimensions of the poster which maximize the area of the printed region.
          </p>
            <ol marker="(A)">
              <li>
                <p>
                  <m>15\ \text{in.}\times 60\ \text{in.}</m> 
                </p>
              </li>
              <li>
                <p>
                  <m>30\ \text{in.}\times 30\ \text{in.}</m> 
                </p>
              </li>
              <li>
                <p>
                  <m>60\ \text{in.}\times 15\ \text{in.}</m> 
                </p>
              </li>
              <li>
                <p>
                  <m>45\ \text{in.}\times 20\ \text{in.}</m> 
                </p>
              </li>
              <li>
                <p>
                  <m>20\ \text{in.}\times 45\ \text{in.}</m> 
                </p>
              </li>
            </ol>
        </statement>
        <answer>
          <p>
            (A)
          </p>
        </answer>
      </exercise>

      <exercise number="5"><!-- #5 -->
        <statement>
          <p>
            Find the area of the largest rectangle that could be inscribed below the parabola <m>y=4-x^2</m> and above the <m>x</m>-axis.
          </p>
            <ol marker="(A)">
              <li>
                <p>
                  <m>\dfrac{64}{9}</m>
                </p>
              </li>
              <li>
                <p>
                  <m>\dfrac{32\sqrt{3}}{9}</m>
                </p>
              </li>
              <li>
                <p>
                  <m>\dfrac{16\sqrt{3}}{3}</m>
                </p>
              </li>
              <li>
                <p>
                  <m>4\sqrt{3}</m>
                </p>
              </li>
              <li>
                <p>
                  <m>\dfrac{32}{9}</m>
                </p>
              </li>
            </ol>
        </statement>
        <answer>
          <p>
            (B)
          </p>
        </answer>
      </exercise>

      <exercise number="6"><!-- #6 -->
        <statement>
          <p>
            Find the minimal distance from the point <m>(4,3)</m> to the line <m>y=-\dfrac{1}{2}x+1</m> using derivative methods.
          </p>
            <ol marker="(A)">
              <li>
                <p>
                  <m>\sqrt{5}</m>
                </p>
              </li>
              <li>
                <p>
                  <m>\dfrac{6\sqrt{5}}{5}</m>
                </p>
              </li>
              <li>
                <p>
                  <m>\dfrac{7\sqrt{5}}{5}</m>
                </p>
              </li>
              <li>
                <p>
                  <m>\dfrac{8\sqrt{5}}{5}</m>
                </p>
              </li>
              <li>
                <p>
                  <m>\dfrac{9\sqrt{5}}{5}</m>
                </p>
              </li>
            </ol>
        </statement>
        <hint>
            <p>
                If <m>p_1=(x_1,y_1)</m> and <m>p_2=(x_2,y_2)</m> are two points, then the distance from <m>p_1</m> to <m>p_2</m> is given by <m>D=\sqrt{(x_2-x_1)^2+(y_2-y_1)^2}</m>.
            </p>
        </hint>
        <answer>
          <p>
            (D)
          </p>
        </answer>
      </exercise>

      <exercise number="7"><!-- #7 -->
        <statement>
          <p>
            Find the most general antiderivative of the function <m>f(x)=\dfrac{\sqrt{x}-\frac{5}{x^2}}{x}</m>.
          </p>
            <ol marker="(A)">
              <li>
                <p>
                  <m>2x^{\frac{1}{2}}+\dfrac{5}{2}x^{-2}+C</m>
                </p>
              </li>
              <li>
                <p>
                  <m>\dfrac{1}{2}x^{-\frac{3}{2}}-10x^{-4}+C</m>
                </p>
              </li>
              <li>
                <p>
                  <m>x^{-\frac{1}{2}}-5x^{-3}+C</m>
                </p>
              </li>
              <li>
                <p>
                  <m>-\dfrac{1}{2}x^{-\frac{3}{2}}+15x^{-4}+C</m>
                </p>
              </li>
              <li>
                <p>
                  <m>\dfrac{4}{3}x^{-\frac{1}{2}}+\dfrac{10}{3}x^{-5}+C</m>
                </p>
              </li>
            </ol>
        </statement>
        <answer>
          <p>
            (A)
          </p>
        </answer>
      </exercise>

      <exercise number="8"><!-- #8 -->
        <statement>
          <p>
            Find the most general antiderivative of the function <m>g(t)=-5\sec^2(t)-4\cos(t)+2^t</m>
          </p>
            <ol marker="(A)">
              <li>
                <p>
                  <m>-10\sec^2(t)\tan(t)+4\sin(t)+2^t\ln(2)+C</m>
                </p>
              </li>
              <li>
                <p>
                  <m>5\tan(t)-4\sin(t)+\dfrac{2^t}{\ln(2)}+C</m>
                </p>
              </li>
              <li>
                <p>
                  <m>5\cot(t)-4\sin(t)+2^t\ln(2)+C</m>
                </p>
              </li>
              <li>
                <p>
                  <m>5\csc^2(t)-4\sin(t)+2^t\ln(2)+C</m>
                </p>
              </li>
              <li>
                <p>
                  <m>-5\tan(t)-4\sin(t)+\dfrac{2^t}{\ln(2)}+C</m>
                </p>
              </li>
            </ol>
        </statement>
        <answer>
          <p>
            (E)
          </p>
        </answer>
      </exercise>
    </paragraphs>
  
  </worksheet>

</article>
