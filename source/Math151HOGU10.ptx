      </exercise>
      <exercise number="23"><!-- #23 -->
        <statement>
          <p>
            Given <m>\displaystyle \int_{-2}^{5}f(x)\ dx=3</m>, <m>\displaystyle \int_{2}^{-2}f(x)\ dx=-4</m>, <m>\displaystyle \int_{2}^{3}f(x)\ dx=5</m>, and <m>\displaystyle \int_{3}^{5}g(x)\ dx=1</m>, find <m>\displaystyle \int_{2}^{5}(f(x)+5g(x))\ dx</m>.
          </p>
            <ol marker="(A)">
              <li>
