              </li>
              <li>
                <p>
                  <m>-6</m>
                </p>
              </li>
              <li>
                <p>
                  <m>-1</m>
                </p>
              </li>
            </ol>
        </statement>
        <answer>
          <p>
            (E)
          </p>
