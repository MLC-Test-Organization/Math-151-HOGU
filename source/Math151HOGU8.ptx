    <paragraphs><!--   %%%%%%%%%%%%%%%%   SECTION 3  %%%%%%%%%%%%%%%%%    -->
      <title>Now Grades Go Up</title>
      
      <exercise number="1"><!-- #1 -->
        <statement>
          <p>
            Approximate <m>\sqrt[4]{16.2}</m> using linear approximation or differentials.
          </p>
            <ol marker="(A)">
              <li>
                <p>
                  <m>2.00125</m>
                </p>
              </li>
              <li>
                <p>
                  <m>2.002</m>
                </p>
              </li>
              <li>
                <p>
                  <m>2.00625</m>
                </p>
              </li>
              <li>
                <p>
                  <m>2.025</m>
                </p>
              </li>
              <li>
                <p>
                  <m>2.05</m>
                </p>
              </li>
            </ol>
        </statement>
        <answer>
          <p>
            (C)
          </p>
        </answer>
      </exercise>

      <exercise number="2"><!-- #2 -->
        <statement>
          <p>
            The radius of a <m>3\text{ ft}</m> long cylinder was measured to be <m>1.2\text{ ft}</m> with a maximum error in measurement of <m>1\text{ in}</m>. Use differentials to estimate the maximum error in the calculated volume of the cylinder.
          </p>
            <ol marker="(A)">
              <li>
                <p>
                  <m>\dfrac{\pi}{10}\text{ ft}^3</m>
                </p>
              </li>
              <li>
                <p>
                  <m>\dfrac{\pi}{2}\text{ ft}^3</m>
                </p>
              </li>
              <li>
                <p>
                  <m>\dfrac{3\pi}{5}\text{ ft}^3</m>
                </p>
              </li>
              <li>
                <p>
                  <m>\dfrac{6\pi}{5}\text{ ft}^3</m>
                </p>
              </li>
              <li>
                <p>
                  <m>\dfrac{3\pi}{2}\text{ ft}^3</m>
                </p>
              </li>
            </ol>
        </statement>
        <answer>
          <p>
            (C)
          </p>
        </answer>
      </exercise>

      <exercise number="3"><!-- #3 -->
        <statement>
          <p>
            Find the critical numbers of the function <m>f(x)=\dfrac{\ln(x^{\frac{2}{3}})}{x^2}</m>.
          </p>
            <ol marker="(A)">
              <li>
                <p>
                  <m>0</m>
                </p>
              </li>
              <li>
                <p>
                  <m>\sqrt{e}</m>
                </p>
              </li>
              <li>
                <p>
                  <m>-\sqrt{e}</m>
                </p>
              </li>
              <li>
                <p>
                  <m>\pm\sqrt{e}</m>
                </p>
              </li>
              <li>
                <p>
                  <m>0,\pm\sqrt{e}</m>
                </p>
              </li>
            </ol>
        </statement>
        <answer>
          <p>
            (D)
          </p>
        </answer>
      </exercise>

      <exercise number="4"><!-- #4 -->
        <statement>
          <p>
            Find the relative extrema of the function <m>g(t)=|9-t^2|</m>.
          </p>
            <ol marker="(A)">
              <li>
                <p>
                  No relative extrema
                </p>
              </li>
              <li>
                <p>
                  Relative minimum at <m>t = 0</m> with value <m>9</m>; No relative maxima
                </p>
              </li>
              <li>
                <p>
                  No relative minima; Relative maximum at <m>t = 0</m> with value <m>9</m>
                </p>
              </li>
              <li>
                <p>
                  Relative minima at <m>t = \pm 3</m> with value <m>0</m>; Relative maximum at <m>t = 0</m> with value <m>9</m>
                </p>
              </li>
              <li>
                <p>
                  Relative minima at <m>t = \pm 3</m> with value <m>0</m>; No relative maxima
                </p>
              </li>
            </ol>
        </statement>
        <answer>
          <p>
            (D)
          </p>
        </answer>
      </exercise>

      <exercise number="5"><!-- #5 -->
        <statement>
          <p>
            What are the value(s) of <m>c</m> that satisfy the conclusion of Rolle's Theorem for the function <m>f(x)=x^3-4x</m> on the interval <m>[0,2]</m>?
          </p>
            <ol marker="(A)">
              <li>
                <p>
                  <m>c=\pm\dfrac{2\sqrt{3}}{3}</m>
                </p>
              </li>
              <li>
                <p>
                  <m>c=\dfrac{2\sqrt{3}}{3}</m>
                </p>
              </li>
              <li>
                <p>
                  <m>c=1</m>
                </p>
              </li>
              <li>
                <p>
                  <m>c=1,\dfrac{2\sqrt{3}}{3}</m>
                </p>
              </li>
              <li>
                <p>
                  <m>c=-\dfrac{2\sqrt{3}}{3}</m>
                </p>
              </li>
            </ol>
        </statement>
        <answer>
          <p>
            (B)
          </p>
        </answer>
      </exercise>

      <exercise number="6"><!-- #6 -->
        <statement>
          <p>
            What are the value(s) of <m>c</m> that satisfy the conclusion of the Mean Value Theorem for the function <m>f(x)=x^3-4x^2+5x+1</m> on the interval <m>[0,2]</m>?
          </p>
            <ol marker="(A)">
              <li>
                <p>
                  <m>c=\dfrac{2}{3}</m>
                </p>
              </li>
              <li>
                <p>
                  <m>c=\dfrac{2}{3},1</m>
                </p>
              </li>
              <li>
                <p>
                  <m>c=1</m>
                </p>
              </li>
              <li>
                <p>
                  <m>c=0,1</m>
                </p>
              </li>
              <li>
                <p>
                  <m>c=\dfrac{2}{3},2</m>
                </p>
              </li>
            </ol>
        </statement>
        <answer>
          <p>
            (A)
          </p>
        </answer>
      </exercise>

      <exercise number="7"><!-- #7 -->
        <statement>
          <p>
            Identify the critical number(s) for the function <m>f(x)=x^{\frac{1}{5}}(3-x)</m>.
          </p>
            <ol marker="(A)">
              <li>
                <p>
                  <m>x=\dfrac{3}{2}</m>
                </p>
              </li>
              <li>
                <p>
                  <m>x=\dfrac{1}{2}</m>
                </p>
              </li>
              <li>
                <p>
                  <m>x=\dfrac{1}{5},3</m>
                </p>
              </li>
              <li>
                <p>
                  <m>x=0,\dfrac{1}{2}</m>
                </p>
              </li>
              <li>
                <p>
                  <m>x=0,3</m>
                </p>
              </li>
            </ol>
        </statement>
        <answer>
          <p>
            (D)
          </p>
        </answer>
      </exercise>
      <p>
        Use the following graph of <m>f'(x)</m> to answer questions 8 and 9.
        <image source="output/h8fig1" width="60%">
              <shortdescription>A graph of a polynomial function. Refer to image description for more detail.</shortdescription><!--This is what a screenreader reads. Do not include math mode here.-->
              <description><!--this is not automatically read by a screenreader, but user can navigate there. Math mode is acceptable here and paragraph environment must be included-->
                <p>
                A graph of a polynomial function <m>f'(x)</m> with seven points marked from left to right. The points are labeled <m>\text{A}, \text{B}, \text{C}, \text{D}, \text{E}, \text{F}</m>, and <m>\text{G}</m>, respectively, on the <m>x</m>-axis. Points <m>\text{A}</m>, <m>\text{D}</m>, and <m>\text{G}</m> lie on the <m>x</m>-axis. Points <m>\text{B}</m> and <m>\text{F}</m> are at the tops of hills and point <m>\text{D}</m> is at the bottom of a valley. <m>\text{C}</m> and <m>\text{E}</m> are inflection points of <m>f'</m>.
                </p>
              </description>
            </image>
      </p>
      <exercise number="8"><!-- #8 -->
        <statement>
          <p>
            On what intervals is <m>f(x)</m> increasing/decreasing?
          </p>
            <ol marker="(A)">
              <li>
                <p>
                  Increasing on <m>(\text{C},\text{E})</m>; Decreasing on <m>(-\infty,\text{C}),(\text{E},\infty)</m>
                </p>
              </li>
              <li>
                <p>
                  Increasing on <m>(\text{D},\infty)</m>; Decreasing on <m>(-\infty,\text{D})</m>
                </p>
              </li>
              <li>
                <p>
                  Increasing on <m>(-\infty,\text{B}),(\text{D},\text{F})</m>; Decreasing on <m>(\text{B},\text{D}),(\text{F},\infty)</m>
                </p>
              </li>
              <li>
                <p>
                  Increasing on <m>(\text{A},\text{G})</m>; Decreasing on <m>(-\infty,\text{A}),(\text{G},\infty)</m>
                </p>
              </li>
              <li>
                <p>
                  Increasing on <m>(\text{A},\text{D}),(\text{D},\text{G})</m>; Decreasing on <m>(-\infty,\text{A}),(\text{G},\infty)</m>
                </p>
              </li>
            </ol>
        </statement>
        <answer>
          <p>
            (E)
          </p>
        </answer>
      </exercise>

      <exercise number="9"><!-- #9 -->
        <statement>
          <p>
            Identify the <m>x</m>-coordinate(s) of any inflection point(s) of <m>f(x)</m>.
          </p>
            <ol marker="(A)">
              <li>
                <p>
                  <m>x=\text{C},\text{E}</m>
                </p>
              </li>
              <li>
                <p>
                  <m>x=\text{B},\text{D},\text{F}</m>
                </p>
              </li>
              <li>
                <p>
                  <m>x=\text{A},\text{D},\text{G}</m>
                </p>
              </li>
              <li>
                <p>
                  <m>x=\text{D}</m>
                </p>
              </li>
              <li>
                <p>
                  <m>x=\text{A},\text{G}</m>
                </p>
              </li>
            </ol>
        </statement>
        <answer>
          <p>
            (B)
          </p>
        </answer>
      </exercise>
    </paragraphs>
  
