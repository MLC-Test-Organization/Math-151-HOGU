<diagram dimensions="(600,600)" margins="5">
  <definition>f1(x)=1/(x+5)</definition>
  <definition>f2(x)=2/3*(x+6)</definition>
  <definition>f3(x)=-sqrt(x)+4</definition>
  <definition>f4(x)=1/((x-4)*(x-7))</definition>
  <definition>f5(x)=(x-7)^2+5</definition>
  <coordinates bbox="(-10,-10,10,10)">
    <grid-axes spacings="((-9,1,9),(-9,1,9))" xlabel="x" ylabel="f(x)" hlabels="(-9,1,9)" 
    vlabels="(-9,1,9)" hticks="(-9,1,9)" vticks="(-9,1,9)" arrows="2"/>
    <graph function="f1" domain="(-10,-3)"/>
    <graph function="f2" domain="(-3,0)"/>
    <graph function="f3" domain="(0,4)"/>
    <graph function="f4" domain="(4,7)"/>
    <graph function="f5" domain="(7,10)"/>
    <line endpoints="((-5,-10),(-5,10))" stroke="orange" thickness="3" dash="6,6"/>
    <line endpoints="((4,-10),(4,10))" stroke="orange" thickness="3" dash="6,6"/>
    <line endpoints="((7,-10),(7,10))" stroke="orange" thickness="3" dash="6,6"/>
    <point at="point" p="(-3,0.5)" alignment="se" size="8" fill="white" stroke="blue"></point>
    <point at="point" p="(-3,2)" alignment="se" size="8" fill="blue" stroke="blue"></point>
    <point at="point" p="(1,3)" alignment="se" size="8" fill="white" stroke="blue"></point>
    <point at="point" p="(1,-1)" alignment="se" size="8" fill="blue" stroke="blue"></point>
    <point at="point" p="(4,2)" alignment="se" size="8" fill="blue" stroke="blue"></point>
    <point at="point" p="(7,5)" alignment="se" size="8" fill="blue" stroke="blue"></point>
  </coordinates>
</diagram>