<diagram dimensions="(300, 300)" margins="5">
  <coordinates bbox="(-10,-10,10,10)">
    <definition>p1=(0,-7)</definition>
    <definition>p2=(0,-10)</definition>
    <definition>p3=(-10,7)</definition>
    <definition>p4=(10,7)</definition>
    <definition>L1=(p3,p4)</definition>
    <definition>L2=(p1,p3)</definition>
    <definition>L3=(p1,p4)</definition>
    <definition>L4=(p1,p2)</definition>
    <point p="p2" size="12" fill="transparent" stroke="transparent"><m>10\text{ N}</m></point>
    <line endpoints="L1" stroke="black" infinite="yes"/>
    <line endpoints="((-9,7.5),(-6,10))" stroke="black"/>
    <line endpoints="((-6,7.5),(-3,10))" stroke="black"/>
    <line endpoints="((-3,7.5),(0,10))" stroke="black"/>
    <line endpoints="((0,7.5),(3,10))" stroke="black"/>
    <line endpoints="((3,7.5),(6,10))" stroke="black"/>
    <line endpoints="((6,7.5),(9,10))" stroke="black"/>
    <line endpoints="L2" stroke="red" arrows="1"/>
    <line endpoints="L3" stroke="red" arrows="1"/>
    <line endpoints="L4" stroke="red" arrows="1"/>
    <point p="p1" size="12" fill="cyan"/>
    <angle-marker points="(p3,p4,p1)" clear-background="no"> <m>45^\circ</m> </angle-marker>
    <angle-marker points="(p1,p3,p4)" clear-background="no"> <m>45^\circ</m> </angle-marker>
  </coordinates>
</diagram>