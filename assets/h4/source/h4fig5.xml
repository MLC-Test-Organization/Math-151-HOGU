<diagram dimensions="(600,300)" margins="5">
  <definition>f1(x)=1/4*(x-2)*(x-4)*(x^2-6*x+2)</definition>
  <definition>f2(x)=3*fabs(x-5)-3</definition>
  <definition>f3(x)=1-(7-x)^(1/3)</definition>
  <definition>f4(x)=1+(x-7)^(1/3)</definition>
  <definition>f5(x)=-0.5/(x-9)+1.5</definition>
  <coordinates bbox="(-1,-5,10,5)">
    <grid-axes spacings="((1,1,9),(-4,1,4))" xlabel="x" ylabel="f(x)" hlabels="(1,1,9)" vlabels="(-4,1,4)" hticks="(1,1,9)" vticks="(-4,1,4)" arrows="2"/>
    <graph function="f1" domain="(0,4)"/>
    <graph function="f2" domain="(4,6)"/>
    <graph function="f3" domain="(6,7)"/>
    <graph function="f4" domain="(7,8)"/>
    <graph function="f5" domain="(8,10)"/>
    <line endpoints="((9,-10),(9,10))" stroke="orange" thickness="3" dash="6,6"/>
    <point at="point" p="(2,0)" alignment="se" size="8" fill="white" stroke="blue"></point>
  </coordinates>
</diagram>