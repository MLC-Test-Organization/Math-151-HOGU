<diagram xmlns="https://prefigure.org" dimensions="(300,300)" margins="5">
<definition>f(x)=-x+3</definition>
  <coordinates bbox="(-2,-4,7,4)">
    <grid-axes spacings="((-1,1,6),(-3,1,3))" xlabel="x" ylabel="y" hlabels="(-1,1,6)" vlabels="(-3,1,3)" hticks="(-1,1,6)" vticks="(-3,1,3)" arrows="2"/>
    <graph function="f" domain="(-7,7)" N="2000"/>
    <line endpoints="((1,-2),(3,f(3)))" stroke="orange" dash="9 9"/>
    <point at="point" p="(1,-2)" alignment="se" size="6" fill="blue" stroke="blue"></point>
  </coordinates>
</diagram>