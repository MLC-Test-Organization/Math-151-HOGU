<diagram dimensions="(300, 300)" margins="5">
  <coordinates bbox="(-10,-10,10,10)">
    <line endpoints="((-10,7),(10,7))" stroke="black" infinite="yes"/>
    <line endpoints="((-9,7.5),(-6,10))" stroke="black"/>
    <line endpoints="((-6,7.5),(-3,10))" stroke="black"/>
    <line endpoints="((-3,7.5),(0,10))" stroke="black"/>
    <line endpoints="((0,7.5),(3,10))" stroke="black"/>
    <line endpoints="((3,7.5),(6,10))" stroke="black"/>
    <line endpoints="((6,7.5),(9,10))" stroke="black"/>
    <line endpoints="((-10,7),(0,-7))" stroke="red"/>
    <line endpoints="((10,7),(0,-7))" stroke="red"/>
    <point p="(0,-7)" size="44" style="box" fill="cyan"/>
  </coordinates>
</diagram>