<diagram dimensions="(300,300)" margins="5">
  <definition>f(t)=(-t^2+2*t+2,-2*t^2+6*t-3)</definition>
  <coordinates bbox="(-4,-4,4,4)">
    <grid-axes spacings="((-3,1,3),(-3,1,3))" xlabel="x" ylabel="y" hlabels="(-3,1,3)" vlabels="(-3,1,3)" hticks="(-3,1,3)" vticks="(-3,1,3)" arrows="2"/>
    <parametric-curve function="f" domain="(-5,5)"/>
  </coordinates>
</diagram>