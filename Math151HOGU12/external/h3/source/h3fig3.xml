<diagram dimensions="(600,600)" margins="5">
  <definition>f1(x)=sqrt(-(x+3))+1</definition>
  <definition>f2(x)=x+4</definition>
  <definition>f3(x)=-x+2</definition>
  <definition>f4(x)=1/(x-2)</definition>
  <definition>f5(x)=1/(x-2)</definition>
  <definition>f6(x)=x-7</definition>
  <coordinates bbox="(-5,-5,5,5)">
    <grid-axes spacings="((-4,1,4),(-4,1,4))" xlabel="x" ylabel="f(x)" hlabels="(-4,1,4)" 
    vlabels="(-9,1,9)" hticks="(-9,1,9)" vticks="(-9,1,9)" arrows="2"/>
    <graph function="f1" domain="(-5,-3)" N="1000"/>
    <graph function="f2" domain="(-3,-1)"/>
    <graph function="f3" domain="(-1,1)"/>
    <graph function="f4" domain="(1,2)"/>
    <graph function="f5" domain="(2,4)"/>
    <graph function="f6" domain="(4,5)"/>
    <line endpoints="((2,-10),(2,10))" stroke="orange" thickness="3" dash="6,6"/>
    <point at="point" p="(-1,3)" alignment="se" size="8" fill="white" stroke="blue"></point>
    <point at="point" p="(-1,-2)" alignment="se" size="8" fill="blue" stroke="blue"></point>
    <point at="point" p="(1,1)" alignment="se" size="8" fill="white" stroke="blue"></point>
    <point at="point" p="(1,-1)" alignment="se" size="8" fill="blue" stroke="blue"></point>
    <point at="point" p="(4,1/2)" alignment="se" size="8" fill="blue" stroke="blue"></point>
    <point at="point" p="(4,-3)" alignment="se" size="8" fill="white" stroke="blue"></point>
  </coordinates>
</diagram>