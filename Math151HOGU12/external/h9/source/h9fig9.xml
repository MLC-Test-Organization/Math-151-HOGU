<diagram xmlns="https://prefigure.org" dimensions="(300,300)" margins="5">
  <definition>f(x)=3*pow(x^5,1/3)/5-1</definition>
  <definition>g(x)=-3*pow((-x)^5,1/3)/5-1</definition>
  <coordinates bbox="(-5,-5,5,5)">
    <grid-axes spacings="((-4,1,4),(-4,1,4))" xlabel="x" ylabel="F(x)" hlabels="" vlabels="" hticks="(-4,1,4)" vticks="(-4,1,4)" arrows="2"/>
    <graph function="f" domain="(0,5)" N="1000"/>
    <graph function="g" domain="(-5,0)" N="1000"/>
  </coordinates>
</diagram>