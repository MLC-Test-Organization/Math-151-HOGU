<diagram xmlns="https://prefigure.org" dimensions="(200,200)" margins="5">
<definition>f(x)=atan(x)</definition>
  <coordinates bbox="(-4,-4,4,4)">
    <grid-axes spacings="((-3,1,3),(-3,1,3))" xlabel="x" ylabel="y" hlabels="" vlabels="" hticks="(-3,1,3)" vticks="(-3,1,3)" arrows="2"/>
    <graph function="f" domain="(-4,4)" thickness="4"/>
    <line endpoints="((-4,pi/2),(4,pi/2))" stroke="orange" dash="9 9" thickness="4"/>
    <line endpoints="((-4,-pi/2),(4,-pi/2))" stroke="orange" dash="9 9" thickness="4"/>
  </coordinates>
</diagram>